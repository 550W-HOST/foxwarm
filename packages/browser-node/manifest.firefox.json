{
  "manifest_version": 3,
  "name": "Foxwarm Browser Node",
  "version": "1.0.0",
  "description": "Connect your browser to Foxwarm as a remote node \u2014 let AI agents browse, screenshot, and interact with web pages.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "webNavigation",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background/main.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-node@foxwarm.dev",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity"
        ],
        "optional": []
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
