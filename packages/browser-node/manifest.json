{
  "manifest_version": 3,
  "name": "Foxwarm Browser Node",
  "version": "1.0.0",
  "description": "Connect your browser to Foxwarm as a remote node \u2014 let AI agents browse, screenshot, and interact with web pages.",
  "permissions": [
    "tabs",
    "debugger",
    "storage",
    "notifications",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120"
}
