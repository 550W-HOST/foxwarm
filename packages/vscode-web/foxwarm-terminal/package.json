{
  "name": "@foxwarm/vscode-web-foxwarm-terminal",
  "version": "0.0.0",
  "private": true,
  "publisher": "foxwarm",
  "license": "MIT",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onTerminalProfile:foxwarm-terminal",
    "onCommand:foxwarm-terminal.newTerminal",
    "onCommand:foxwarm-terminal.toggleTerminal"
  ],
  "contributes": {
    "commands": [
      {
        "command": "foxwarm-terminal.newTerminal",
        "title": "Foxwarm: New Terminal",
        "category": "Foxwarm",
        "icon": "$(terminal)"
      },
      {
        "command": "foxwarm-terminal.toggleTerminal",
        "title": "Foxwarm: Toggle Terminal",
        "category": "Foxwarm",
        "icon": "$(terminal)"
      }
    ],
    "keybindings": [
      {
        "command": "foxwarm-terminal.toggleTerminal",
        "key": "ctrl+`",
        "mac": "ctrl+`",
        "when": "virtualWorkspace == foxwarm"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "foxwarm-terminal",
          "title": "Foxwarm Terminal",
          "icon": "terminal"
        }
      ]
    }
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "web"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0"
  }
}
