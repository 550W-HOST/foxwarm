# Foxwarm Configuration

# Bot Identification
BOT_NAME=foxwarm             # Bot name (used in logs and startup message)

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id

# Matrix Configuration (optional)
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=your_matrix_access_token
# MATRIX_USER_ID=@yourbot:matrix.org
# MATRIX_ALLOWED_USERS=@user1:matrix.org,@user2:matrix.org  # Additional authorized users (comma-separated)

# WeChat Work (企业微信) Webhook Configuration (optional)
# WEWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
# WEWORK_TOKEN=your_wework_token_here
# WEWORK_ENCODING_AES_KEY=your_encoding_aes_key_here
# WEWORK_LISTEN_PORT=3002
# WEWORK_LISTEN_PATH=/wework/webhook
# WEWORK_ALLOWED_USERS=user1,user2  # Authorized WeWork users (comma-separated)
# WEWORK_DEFAULT_USER=user1         # Default user for main session attachment

# HTTP Server Configuration
HTTP_PORT=3001                # Unified port for WebUI and Trigger (default: 3001)
ENABLE_WEBUI=true            # Enable WebUI interface (default: true)
ENABLE_TRIGGER=true          # Enable external trigger endpoint (default: true)

# LLM Configuration
#
# Model selection lives in a YAML file:
#   - default location: state/models.yaml
#   - tracked template: templates/models.example.yaml
#
# Recommended first-time setup:
#   mkdir -p state
#   cp templates/models.example.yaml state/models.yaml
#
# Optional: point to a custom file instead
# MODELS_CONFIG_PATH=state/models.yaml
#
# Provider credentials and default endpoints usually stay in .env.

# Option 1: OpenAI (or OpenAI-compatible API)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Common LLM settings
# MAX_OUTPUT=16384  # Maximum output tokens
# THINKING_BUDGET=10000  # Thinking budget (Anthropic only)

# Vector Database (for embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# Context Management
CONTEXT_LIMIT=122880         # Maximum context tokens
COMPACT_PERCENT=0.1          # Percentage of messages to keep when compacting (0.1 = 10%)
