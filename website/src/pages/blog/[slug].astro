---
import BlogPost from '../../components/BlogPost.astro';
import { getPostGroups } from '../../blog/posts';

export async function getStaticPaths() {
  return (await getPostGroups()).filter((group) => group.versions.en).map((group) => ({ params: { slug: group.slug }, props: { group } }));
}
---
<BlogPost lang="en" group={Astro.props.group} />
