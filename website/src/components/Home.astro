---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/home.css';
import Screenshot from './Screenshot.astro';
import Icon from './Icon.astro';
import { strings, installCommands, githubUrl, siteUrl, type Lang } from '../i18n/home';

import HandsDiagram from './HandsDiagram.astro';
import heroLight from '../assets/screens/hero-light.png';
import heroDark from '../assets/screens/hero-dark.png';
import memoryLight from '../assets/screens/memory-light.png';
import memoryDark from '../assets/screens/memory-dark.png';
import nodesLight from '../assets/screens/nodes-light.png';
import nodesDark from '../assets/screens/nodes-dark.png';
import teamLight from '../assets/screens/team-light.png';
import teamDark from '../assets/screens/team-dark.png';
import steerLight from '../assets/screens/steer-light.png';
import steerDark from '../assets/screens/steer-dark.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const featureSizes = '(min-width: 1200px) 1120px, 100vw';
const featureWidths = [640, 960, 1360, 1800];
const installTabs = [
  { id: 'linux', label: t.install.tabs.linux, command: installCommands.linux, note: t.install.notes.linux, prompt: '$' },
  { id: 'windows', label: t.install.tabs.windows, command: installCommands.windows, note: t.install.notes.windows, prompt: 'PS>' },
  { id: 'docker', label: t.install.tabs.docker, command: installCommands.docker, note: t.install.notes.docker, prompt: '$' }
];
const docsHref = (page = '') => `${lang === 'zh' ? '/zh' : ''}/docs/${page}`;
---
<!doctype html>
<html lang={t.htmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + t.path} />
    <meta property="og:image" content={siteUrl + heroLight.src} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <link rel="canonical" href={siteUrl + t.path} />
    <link rel="alternate" hreflang="en" href={siteUrl + strings.en.path} />
    <link rel="alternate" hreflang="zh-CN" href={siteUrl + strings.zh.path} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + strings.en.path} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <script is:inline>
      (() => {
        // Shared with the Starlight docs, which store 'light', 'dark' or 'auto'.
        let saved = null;
        try { saved = localStorage.getItem('starlight-theme'); } catch {}
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={t.path} aria-label="Foxwarm">
          <img src="/favicon.svg" alt="" width="26" height="26" />
          <span>Foxwarm</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          <a href={docsHref()}>{t.nav.docs}</a>
          <a href={githubUrl}>{t.nav.github}</a>
          <a href={strings[other].path} hreflang={strings[other].htmlLang} lang={strings[other].htmlLang} aria-label={t.nav.languageLabel}>{t.nav.language}</a>
          <button class="theme-toggle" type="button" aria-label={t.nav.theme} title={t.nav.theme}>
            <Icon name="sun" class="theme-icon-light" /><Icon name="moon" class="theme-icon-dark" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">{t.hero.title}</h1>
            <p class="lede">{t.hero.lede}</p>

            <div class="install" id="install" data-tabs>
              <div class="install-tabs" role="tablist" aria-label={t.nav.install}>
                {installTabs.map((tab, index) => (
                  <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tab={tab.id}>{tab.label}</button>
                ))}
              </div>
              {installTabs.map((tab, index) => (
                <div class="install-panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={index !== 0}>
                  <div class="command">
                    <pre><code>{tab.command.split('\n').map((line) => (<span class="command-line"><span class="prompt" aria-hidden="true">{tab.prompt}</span>{line}</span>))}</code></pre>
                    <button class="copy-button" type="button" data-copy={tab.command} data-copied={t.install.copied}>{t.install.copy}</button>
                  </div>
                  <p class="install-note">{tab.note} <a href={docsHref('installing/')}>{t.install.requirementsLink}</a></p>
                </div>
              ))}
            </div>
          </div>

          <figure class="day" aria-labelledby="day-label">
            <figcaption id="day-label" class="day-label">{t.hero.timeline.label}</figcaption>
            <ol class="day-rows">
              {t.hero.timeline.rows.map((row) => (
                <li class:list={['day-row', { highlight: row.highlight }]}>
                  <time>{row.time}</time>
                  <span class="day-dot" aria-hidden="true"></span>
                  <div class="day-text">
                    {row.place && <span class="day-place">{row.icon && <Icon name={row.icon} />}{row.place}</span>}
                    <p>{row.text}{row.quote && <>{lang === 'en' ? ' ' : ''}<q>{row.quote}</q></>}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="day-footer">{t.hero.timeline.footer} <a href={docsHref('how-it-works/')}>{t.hero.timeline.link} →</a></p>
          </figure>
        </div>

        <figure class="container hero-shot">
          <Screenshot light={heroLight} dark={heroDark} alt={t.hero.screenshotAlt} eager widths={[960, 1440, 2000, 2880]} sizes="(min-width: 1260px) 1200px, 100vw" />
          <figcaption>{t.hero.shotCaption}</figcaption>
        </figure>
      </section>

      <section class="strip" aria-label={t.strip.label}>
        <div class="container strip-inner">
          <span class="strip-label">{t.strip.label}</span>
          <ul>{t.strip.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <div id="features" class="features">
        {t.features.map((feature, index) => (
          <section class:list={['feature', `feature-${feature.id}`]} aria-labelledby={`feature-${feature.id}`}>
            <div class="container">
              <div class="feature-head">
                <div class="feature-title">
                  <p class="label"><span>{String(index + 1).padStart(2, '0')}</span>{feature.eyebrow}</p>
                  <h2 id={`feature-${feature.id}`}>{feature.title}</h2>
                  {feature.id === 'room' && (
                    <div class="chat-demo" role="img" aria-label={feature.image.alt}>
                      <div class="chat-head">
                        <span class="chat-avatar" aria-hidden="true">{t.room.title.slice(0, 1).toUpperCase()}</span>
                        <div><strong>{t.room.title}</strong><small>{t.room.status}</small></div>
                      </div>
                      <div class="chat-body">
                        {t.room.messages.map((message) => (
                          message.from === 'system' ? (
                            <p class="chat-system">{message.text}</p>
                          ) : (
                            <div class:list={['bubble', message.from]}>
                              {message.name && <strong class="bubble-name">{message.name}</strong>}
                              <p>{message.text}</p>
                              {message.time && <time>{message.time}</time>}
                            </div>
                          )
                        ))}
                      </div>
                    </div>
                  )}
                </div>
                <div class="feature-copy">
                  <p>{feature.body}</p>
                  <ul class="points">{feature.points.map((point) => <li>{point}</li>)}</ul>
                  <a class="text-link" href={feature.link.href}>{feature.link.label} →</a>
                </div>
              </div>
              {feature.id !== 'room' && <div class="feature-visual">
                {feature.id === 'memory' && (
                  <div class="shot-clip"><Screenshot light={memoryLight} dark={memoryDark} alt={feature.image.alt} widths={featureWidths} sizes={featureSizes} /></div>
                )}
                {feature.id === 'hands' && (
                  <div class="hands-grid">
                    <HandsDiagram d={t.diagram} alt={feature.image.alt} />
                    <div class="advanced">
                      <h3>{t.advanced.title}</h3>
                      <dl>
                        {t.advanced.items.map((item) => (<><dt>{item.title}</dt><dd>{item.body}</dd></>))}
                      </dl>
                    </div>
                    <div class="advanced-shot shot-clip">
                      <Screenshot light={nodesLight} dark={nodesDark} alt={feature.image.detailAlt ?? ''} widths={featureWidths} sizes={featureSizes} />
                    </div>
                  </div>
                )}
                {feature.id === 'team' && (
                  <div class="shot-stack">
                    <Screenshot light={teamLight} dark={teamDark} alt={feature.image.alt} widths={featureWidths} sizes={featureSizes} />
                    <div class="shot-inset">
                      <Screenshot light={steerLight} dark={steerDark} alt={feature.image.detailAlt ?? ''} widths={[480, 720, 1080]} sizes="(min-width: 1100px) 400px, 60vw" />
                    </div>
                  </div>
                )}
              </div>}
            </div>
          </section>
        ))}
      </div>

      <section class="extras" aria-labelledby="extras-title">
        <div class="container extras-inner">
          <h2 id="extras-title">{t.extras.title}</h2>
          <dl class="extra-list">
            {t.extras.items.map((item) => (<div><dt>{item.title}</dt><dd>{item.body}</dd></div>))}
          </dl>
        </div>
      </section>

      <section class="start" aria-labelledby="start-title">
        <div class="container">
          <h2 id="start-title">{t.start.title}</h2>
          <ol class="steps">
            {t.start.steps.map((step) => (
              <li><h3>{step.title}</h3><p>{step.body}</p></li>
            ))}
          </ol>
          <p class="start-foot">{t.start.lede} <a href={docsHref('installing/')}>{t.start.guide} →</a></p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href={t.path}><img src="/favicon.svg" alt="" width="24" height="24" /><span>Foxwarm</span></a>
        <p>{t.footer.tagline}</p>
        <nav aria-label="Footer">
          <a href={docsHref()}>{t.footer.docs}</a>
          <a href={githubUrl}>{t.footer.github}</a>
          <a href={`${githubUrl}/blob/main/LICENSE`}>{t.footer.license}</a>
          <a href={strings[other].path} hreflang={strings[other].htmlLang} lang={strings[other].htmlLang}>{t.nav.language}</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        document.querySelector('.theme-toggle')?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('starlight-theme', next); } catch {}
        });

        for (const group of document.querySelectorAll('[data-tabs]')) {
          const tabs = [...group.querySelectorAll('[role="tab"]')];
          const select = (tab, focus) => {
            for (const other of tabs) {
              const active = other === tab;
              other.setAttribute('aria-selected', String(active));
              other.tabIndex = active ? 0 : -1;
              document.getElementById(other.getAttribute('aria-controls')).hidden = !active;
            }
            if (focus) tab.focus();
          };
          tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => select(tab, false));
            tab.addEventListener('keydown', (event) => {
              const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
              if (!step) return;
              event.preventDefault();
              select(tabs[(index + step + tabs.length) % tabs.length], true);
            });
          });
          const platform = (navigator.userAgentData?.platform || navigator.platform || '').toLowerCase();
          if (platform.startsWith('win')) select(tabs.find((tab) => tab.dataset.tab === 'windows'), false);
        }

        for (const button of document.querySelectorAll('.copy-button')) {
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(button.dataset.copy || '');
              const previous = button.textContent;
              button.textContent = button.dataset.copied || 'Copied';
              button.classList.add('copied');
              setTimeout(() => { button.textContent = previous; button.classList.remove('copied'); }, 1500);
            } catch {}
          });
        }
      })();
    </script>
  </body>
</html>
