---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/home.css';
import Screenshot from './Screenshot.astro';
import Icon from './Icon.astro';
import Command from './Command.astro';
import InstallCommands, { type InstallTab } from './InstallCommands.astro';
import PlatformMark from './PlatformMark.astro';
import DownloadSchematic from './DownloadSchematic.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ThemeInit from './ThemeInit.astro';
import { strings, installCommands, siteUrl, docsPath, demoSession, heroDemoSession, featureDemoSessions, downloadFiles, latestReleaseUrl, type Lang } from '../i18n/home';

import HandsDiagram from './HandsDiagram.astro';
import heroLight from '../assets/screens/hero-light.png';
import heroDark from '../assets/screens/hero-dark.png';
import memoryLight from '../assets/screens/memory-light.png';
import memoryDark from '../assets/screens/memory-dark.png';
import nodesLight from '../assets/screens/nodes-light.png';
import nodesDark from '../assets/screens/nodes-dark.png';
import teamLight from '../assets/screens/team-light.png';
import teamDark from '../assets/screens/team-dark.png';
import steerLight from '../assets/screens/steer-light.png';
import steerDark from '../assets/screens/steer-dark.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const featureSizes = '(min-width: 1200px) 1120px, 100vw';
const featureWidths = [640, 960, 1360, 1800];
const installTabs: InstallTab[] = [
  { id: 'linux', label: t.install.tabs.linux, command: installCommands.linux, prompt: '$' },
  { id: 'windows', label: t.install.tabs.windows, command: installCommands.windows, prompt: 'PS>' }
];
const docsHref = (page = '') => docsPath(lang, page);
const d = t.downloads;
const desktopDownloads = [
  { option: d.desktop.windows, file: downloadFiles.windowsDesktop, mark: 'windows' as const, alternative: { label: d.desktop.windows.alternative, file: downloadFiles.windowsDesktopPortable } },
  { option: d.desktop.mac, file: downloadFiles.macDesktop, mark: 'macos' as const, alternative: undefined }
];
---
<!doctype html>
<html lang={t.htmlLang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + t.path} />
    <meta property="og:image" content={siteUrl + heroLight.src} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <link rel="canonical" href={siteUrl + t.path} />
    <link rel="alternate" hreflang="en" href={siteUrl + strings.en.path} />
    <link rel="alternate" hreflang="zh-CN" href={siteUrl + strings.zh.path} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + strings.en.path} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
    <ThemeInit />
  </head>
  <body>
    <SiteHeader lang={lang} path={strings[lang].path} languageHref={strings[other].path} />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">{t.hero.title}</h1>
            <p class="lede">{t.hero.lede}</p>

            <div class="hero-start" id="install">
              <InstallCommands idPrefix="hero" label={t.nav.install} title={t.install.title} tabs={installTabs} copy={t.install.copy} class="hero-command" />
              <p class="hero-actions">
                <a class="hero-demo" href={demoSession(heroDemoSession)}>{t.hero.actions.demo}</a>
                <a class="hero-more" href="#download">{t.hero.actions.more} ↓</a>
              </p>
            </div>
          </div>

          <figure class="day" aria-labelledby="day-label">
            <figcaption id="day-label" class="day-label">{t.hero.timeline.label}</figcaption>
            <ol class="day-rows">
              {t.hero.timeline.rows.map((row) => (
                <li class:list={['day-row', { highlight: row.highlight }]}>
                  <time>{row.time}</time>
                  <span class="day-dot" aria-hidden="true"></span>
                  <div class="day-text">
                    {row.place && <span class="day-place">{row.icon && <Icon name={row.icon} />}{row.place}</span>}
                    <p>{row.text}{row.quote && <>{lang === 'en' ? ' ' : ''}<q>{row.quote}</q></>}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="day-footer">{t.hero.timeline.footer} <a href={docsHref('how-it-works/')}>{t.hero.timeline.link} →</a></p>
          </figure>
        </div>

        <figure class="container hero-shot">
          <Screenshot light={heroLight} dark={heroDark} alt={t.hero.screenshotAlt} eager widths={[960, 1440, 2000, 2880]} sizes="(min-width: 1260px) 1200px, 100vw" />
          <figcaption>
            <span class="shot-caption">{t.hero.shotCaption}</span>
            <span class="demo-entry">
              <a class="demo-link" href={demoSession(heroDemoSession)}>{t.hero.demo.link} →</a>
              <span class="demo-note">{t.hero.demo.note}</span>
            </span>
          </figcaption>
        </figure>
      </section>

      <section class="strip" aria-label={t.strip.label}>
        <div class="container strip-inner">
          <span class="strip-label">{t.strip.label}</span>
          <ul>{t.strip.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <div id="features" class="features">
        {t.features.map((feature, index) => (
          <section class:list={['feature', `feature-${feature.id}`]} aria-labelledby={`feature-${feature.id}`}>
            <div class="container">
              <div class="feature-head">
                <div class="feature-title">
                  <p class="label"><span>{String(index + 1).padStart(2, '0')}</span>{feature.eyebrow}</p>
                  <h2 id={`feature-${feature.id}`}>{feature.title}</h2>
                  {feature.id === 'room' && (
                    <div class="chat-demo" role="img" aria-label={feature.image.alt}>
                      <div class="chat-head">
                        <span class="chat-avatar" aria-hidden="true">{t.room.title.slice(0, 1).toUpperCase()}</span>
                        <div><strong>{t.room.title}</strong><small>{t.room.status}</small></div>
                      </div>
                      <div class="chat-body">
                        {t.room.messages.map((message) => (
                          message.from === 'system' ? (
                            <p class="chat-system">{message.text}</p>
                          ) : (
                            <div class:list={['bubble', message.from]}>
                              {message.name && <strong class="bubble-name">{message.name}</strong>}
                              <p>{message.text}</p>
                              {message.time && <time>{message.time}</time>}
                            </div>
                          )
                        ))}
                      </div>
                    </div>
                  )}
                </div>
                <div class="feature-copy">
                  <p>{feature.body}</p>
                  <ul class="points">{feature.points.map((point) => <li>{point}</li>)}</ul>
                  <p class="feature-links">
                    <a class="text-link" href={feature.link.href}>{feature.link.label} →</a>
                    {featureDemoSessions[feature.id] && <a class="text-link" href={demoSession(featureDemoSessions[feature.id]!)}>{t.featureDemo} →</a>}
                  </p>
                </div>
              </div>
              {feature.id !== 'room' && <div class="feature-visual">
                {feature.id === 'memory' && (
                  <div class="shot-clip"><Screenshot light={memoryLight} dark={memoryDark} alt={feature.image.alt} widths={featureWidths} sizes={featureSizes} /></div>
                )}
                {feature.id === 'hands' && (
                  <div class="hands-grid">
                    <HandsDiagram d={t.diagram} alt={feature.image.alt} />
                    <div class="advanced">
                      <h3>{t.advanced.title}</h3>
                      <dl>
                        {t.advanced.items.map((item) => (<><dt>{item.title}</dt><dd>{item.body}</dd></>))}
                      </dl>
                    </div>
                    <div class="advanced-shot shot-clip">
                      <Screenshot light={nodesLight} dark={nodesDark} alt={feature.image.detailAlt ?? ''} widths={featureWidths} sizes={featureSizes} />
                    </div>
                  </div>
                )}
                {feature.id === 'team' && (
                  <div class="shot-stack">
                    <Screenshot light={teamLight} dark={teamDark} alt={feature.image.alt} widths={featureWidths} sizes={featureSizes} />
                    <div class="shot-inset">
                      <Screenshot light={steerLight} dark={steerDark} alt={feature.image.detailAlt ?? ''} widths={[480, 720, 1080]} sizes="(min-width: 1100px) 400px, 60vw" />
                    </div>
                  </div>
                )}
              </div>}
            </div>
          </section>
        ))}
      </div>

      <section class="extras" aria-labelledby="extras-title">
        <div class="container extras-inner">
          <h2 id="extras-title">{t.extras.title}</h2>
          <dl class="extra-list">
            {t.extras.items.map((item) => (<div><dt>{item.title}</dt><dd>{item.body}</dd></div>))}
          </dl>
        </div>
      </section>

      <section class="downloads" id="download" aria-labelledby="download-title">
        <div class="container">
          <h2 id="download-title">{d.title}</h2>
          <div class="download-row">
            <div class="download-kind">
              <DownloadSchematic kind="desktop" />
              <h3>{d.desktop.title}</h3>
              <p>{d.desktop.body}</p>
            </div>
            <div class="download-options">
              {desktopDownloads.map(({ option, file, mark, alternative }) => (
                <div class="download-option" data-platform={file.platform}>
                  <p class="download-name"><PlatformMark name={mark} />{option.name} <span>{option.detail}</span><span class="download-current" hidden>{d.current}</span></p>
                  <p class="download-action"><a class="download-button" href={file.href}><Icon name="download" />{d.download}</a><code>{file.file}</code></p>
                  {alternative && <p class="download-alternative"><a href={alternative.file.href}>{alternative.label}</a><code>{alternative.file.file}</code></p>}
                  <p class="download-note">{option.note} <a href={option.guide.href}>{option.guide.label} →</a></p>
                </div>
              ))}
            </div>
          </div>
          <div class="download-row">
            <div class="download-kind">
              <DownloadSchematic kind="server" />
              <h3>{d.server.title}</h3>
              <p>{d.server.body}</p>
            </div>
            <div class="download-options download-options-wide">
              <div class="download-option">
                <p class="download-name"><span class="platform-marks"><PlatformMark name="linux" /><PlatformMark name="macos" /><PlatformMark name="windows" /></span>{d.server.installers.name}</p>
                <InstallCommands idPrefix="server" label={d.server.installers.name} tabs={installTabs} copy={t.install.copy} />
                <p class="download-note">{d.server.installers.note} <a href={d.server.installers.guide.href}>{d.server.installers.guide.label} →</a></p>
              </div>
              <div class="download-option">
                <p class="download-name"><PlatformMark name="docker" />{d.server.docker.name} <span>{d.server.docker.detail}</span></p>
                <div class="command-card"><Command command={installCommands.docker} prompt="$" copy={t.install.copy} /></div>
                <p class="download-note">{d.server.docker.note} <a href={d.server.docker.guide.href}>{d.server.docker.guide.label} →</a></p>
              </div>
              <p class="download-more"><a href={d.server.packages.href}>{d.server.packages.label} →</a></p>
            </div>
          </div>
          <div class="download-row">
            <div class="download-kind">
              <DownloadSchematic kind="android" />
              <h3>{d.android.title}</h3>
              <p>{d.android.body}</p>
            </div>
            <div class="download-options">
              <div class="download-option" data-platform={downloadFiles.androidNode.platform}>
                <p class="download-name"><PlatformMark name="android" />{d.android.app.name} <span>{d.android.app.detail}</span><span class="download-current" hidden>{d.current}</span></p>
                <p class="download-action"><a class="download-button" href={downloadFiles.androidNode.href}><Icon name="download" />{d.download}</a><code>{downloadFiles.androidNode.file}</code></p>
                <p class="download-note">{d.android.app.note} <a href={d.android.app.guide.href}>{d.android.app.guide.label} →</a></p>
              </div>
            </div>
          </div>
          <div class="download-foot">
            <p><a href={latestReleaseUrl}>{d.release} →</a></p>
            <p class="download-attribution">{d.attribution}</p>
          </div>
        </div>
      </section>

      <section class="start" aria-labelledby="start-title">
        <div class="container">
          <h2 id="start-title">{t.start.title}</h2>
          <ol class="steps">
            {t.start.steps.map((step) => (
              <li><h3>{step.title}</h3><p>{step.body}</p></li>
            ))}
          </ol>
          <p class="start-foot">{t.start.lede} <a href={docsHref('installing/')}>{t.start.guide} →</a></p>
        </div>
      </section>
      <span class="visually-hidden" role="status" data-copy-status data-copied={t.install.copied}></span>
    </main>

    <SiteFooter lang={lang} languageHref={strings[other].path} />

    <script>
      import { detectPlatform } from '../scripts/platform.mjs';

      const platform = detectPlatform(navigator);
      for (const group of document.querySelectorAll('[data-tabs]')) {
        const tabs = [...group.querySelectorAll('[role="tab"]')];
        const select = (tab, focus) => {
          for (const other of tabs) {
            const active = other === tab;
            other.setAttribute('aria-selected', String(active));
            other.tabIndex = active ? 0 : -1;
            document.getElementById(other.getAttribute('aria-controls')).hidden = !active;
          }
          if (focus) tab.focus();
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => select(tab, false));
          tab.addEventListener('keydown', (event) => {
            const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
            if (!step) return;
            event.preventDefault();
            select(tabs[(index + step + tabs.length) % tabs.length], true);
          });
        });
        if (platform === 'windows') select(tabs.find((tab) => tab.dataset.tab === 'windows'), false);
      }

      // Emphasize the download for this device; every option stays available.
      if (platform) {
        for (const option of document.querySelectorAll(`.download-option[data-platform="${platform}"]`)) {
          option.classList.add('current');
          option.querySelector('.download-current')?.removeAttribute('hidden');
        }
      }

      // The icon shows a check while the live region tells assistive technology that the command was copied.
      const copyStatus = document.querySelector('[data-copy-status]');
      for (const button of document.querySelectorAll('.copy-button')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy || '');
            button.classList.add('copied');
            if (copyStatus) copyStatus.textContent = copyStatus.dataset.copied || '';
            setTimeout(() => {
              button.classList.remove('copied');
              if (copyStatus) copyStatus.textContent = '';
            }, 1500);
          } catch {}
        });
      }
    </script>
  </body>
</html>
