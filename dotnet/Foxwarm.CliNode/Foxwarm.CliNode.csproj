<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Capabilities.json" />
    <ProjectReference Include="../Foxwarm.NodePrimitives/Foxwarm.NodePrimitives.csproj" />
    <!-- The prebuilt browser host sits beside the executable. The delivery asset step builds it
         (npm run build:host); compilation never invokes npm. -->
    <Content
      Include="../../packages/browser-host/dist/browser-host.bundle.cjs"
      Condition="Exists('../../packages/browser-host/dist/browser-host.bundle.cjs')"
      Link="browser-host.bundle.cjs"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="../../packages/browser-host/dist/browser-host.bundle.cjs.LEGAL.txt"
      Condition="Exists('../../packages/browser-host/dist/browser-host.bundle.cjs.LEGAL.txt')"
      Link="browser-host.bundle.cjs.LEGAL.txt"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Target
    Name="ValidateStaticMuslCli"
    BeforeTargets="PrepareForBuild"
    Condition="'$(FoxwarmStaticMusl)' == 'true'"
  >
    <Error
      Condition="'$(RuntimeIdentifier)' != 'linux-musl-x64' or '$(PublishAot)' != 'true' or '$(StaticExecutable)' != 'true'"
      Text="FoxwarmStaticMusl requires a linux-musl-x64 static Native AOT CLI publication."
    />
  </Target>
  <Target
    Name="PrepareStaticMuslPty"
    BeforeTargets="ComputeIlcCompileInputs"
    Condition="'$(FoxwarmStaticMusl)' == 'true'"
  >
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="gcc -std=c11 -O2 -Wall -Wextra -Werror -fPIC -DFOXWARM_STATIC_MUSL -c -o &quot;$(IntermediateOutputPath)native/foxwarm-pty.o&quot; &quot;$(MSBuildProjectDirectory)/../Foxwarm.NodePrimitives/Terminal/native/foxwarm-pty.c&quot;" />
    <ItemGroup>
      <DirectPInvoke Include="libc" />
      <DirectPInvoke Include="foxwarm-pty" />
      <NativeLibrary Include="$(IntermediateOutputPath)native/foxwarm-pty.o" />
    </ItemGroup>
  </Target>
</Project>
