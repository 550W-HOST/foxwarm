<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Web SDK defaults to Server GC. Main is a long-lived, mostly I/O-bound single
         process; workstation concurrent GC keeps transient allocation peaks and retained
         committed memory proportional to the live set. The in-process Desktop host already
         uses the plain SDK's workstation default. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Foxwarm.NodePrimitives/Foxwarm.NodePrimitives.csproj" />
    <EmbeddedResource Include="Code/workbench.html" />
    <EmbeddedResource Include="McpInboundTools.json" />
    <EmbeddedResource Include="Channels/CommandCatalog.json" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <Protobuf Include="ToolScript/Protocol/monty.proto" GrpcServices="None" />
    <Content
      Include="ToolScript/*LICENSE"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="ToolScript/THIRD-PARTY-NOTICES.md"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <PackageReference Include="SkiaSharp" Version="4.153.1" GeneratePathProperty="true" />
    <PackageReference
      Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
      GeneratePathProperty="true"
      Version="4.153.1"
      Condition="('$(RuntimeIdentifier)' == '' and '$(OS)' != 'Windows_NT') or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))"
    />
    <PackageReference
      Include="SkiaSharp.NativeAssets.Win32"
      Version="4.153.1"
      GeneratePathProperty="true"
      Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')"
    />
    <!-- The original package supplies the unchanged RID-native libraries. -->
    <PackageReference Include="LanceDB" Version="[2.5.0]" ExcludeAssets="compile;runtime" />
    <ProjectReference Include="../Foxwarm.LanceDb/Foxwarm.LanceDb.csproj" />
    <PackageReference Include="Apache.Arrow" Version="[22.1.0]" />
    <Content
      Include="Vector/Licenses/*.txt"
      Link="%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Content
      Include="Timers/THIRD-PARTY-NOTICES.md"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <!-- Prefer an explicit target; source builds use the SDK's portable RID. -->
  <PropertyGroup>
    <MontyTargetRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MontyTargetRid>
    <MontyTargetRid Condition="'$(MontyTargetRid)' == ''"
      >$(NETCoreSdkPortableRuntimeIdentifier)</MontyTargetRid>
    <MontyExecutable Condition="'$(MontyTargetRid)' == 'win-x64'">monty.exe</MontyExecutable>
    <MontyExecutable
      Condition="'$(MontyTargetRid)' == 'linux-x64' or '$(MontyTargetRid)' == 'osx-x64' or '$(MontyTargetRid)' == 'osx-arm64'"
      >monty</MontyExecutable>
    <MontyNativePrefix>$(MSBuildProjectDirectory)/obj/monty-0.0.19/$(MontyTargetRid)</MontyNativePrefix>
    <MontyPython Condition="'$(OS)' != 'Windows_NT'">python3</MontyPython>
    <MontyPython Condition="'$(OS)' == 'Windows_NT'">python</MontyPython>
  </PropertyGroup>
  <Target
    Name="PrepareMontyWorker"
    BeforeTargets="AssignTargetPaths"
    Condition="'$(MontyExecutable)' != ''"
  >
    <Exec
      Condition="!Exists('$(MontyNativePrefix)/bin/$(MontyExecutable)')"
      Command="$(MontyPython) &quot;$(MSBuildProjectDirectory)/../scripts/acquire-monty-native.py&quot; &quot;$(MontyNativePrefix)&quot; --rid $(MontyTargetRid)"
    />
    <ItemGroup>
      <Content
        Include="$(MontyNativePrefix)/bin/$(MontyExecutable)"
        Link="ToolScript/native/$(MontyExecutable)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
  <Import Project="Delivery.targets" />
</Project>
