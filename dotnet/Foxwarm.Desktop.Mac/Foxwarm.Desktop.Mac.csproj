<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <AssemblyName>Foxwarm.Desktop</AssemblyName>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <ApplicationTitle>Foxwarm</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The Apple SDK would otherwise add an unsigned installer package to Release publishes. -->
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>
  <ItemGroup>
    <BundleResource Include="Foxwarm.icns" />
    <BundleResource
      Include="../../packages/webui/public/favicon.LICENSE.txt"
      LogicalName="Foxwarm-icon-LICENSE.txt"
    />
    <ProjectReference
      Include="../Foxwarm/Foxwarm.csproj"
      AdditionalProperties="FoxwarmConsoleEntry=false;ArtifactTargetRid=$(RuntimeIdentifier)"
    />
  </ItemGroup>
  <!-- Keep Main's resource-relative paths beneath AppContext.BaseDirectory. The
       Apple SDK cannot infer locations for Content inherited through project references.
       It also links every bundled dylib into the executable unless it is a PluginLibrary,
       which is copied to the same place. Main loads its own and its packages' libraries
       at run time (by path or by DllImport name), and sharp loads libvips through its
       addon's rpath, so only the .NET and Apple runtime libraries stay linked. -->
  <Target Name="PrepareMacBundleResources" BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Foxwarm.runtimeconfig.json'"
      />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(ResolvedFileToPublish)">
      <Output TaskParameter="Filtered" ItemName="_MacPublishFiles" />
    </RemoveDuplicates>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_MacPublishFiles)" />
      <ResolvedFileToPublish
        Update="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.MSBuildSourceProjectFile)' != '' and '%(ResolvedFileToPublish.PublishFolderType)' == '' and '%(ResolvedFileToPublish.Extension)' != '.dylib'"
      >
        <PublishFolderType>Assembly</PublishFolderType>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Update="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.dylib' and '%(ResolvedFileToPublish.PublishFolderType)' == '' and !$([System.String]::Copy('%(ResolvedFileToPublish.NuGetPackageId)').StartsWith('Microsoft.NETCore.App.Runtime.')) and !$([System.String]::Copy('%(ResolvedFileToPublish.NuGetPackageId)').StartsWith('Microsoft.macOS.Runtime.'))"
      >
        <PublishFolderType>PluginLibrary</PublishFolderType>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
