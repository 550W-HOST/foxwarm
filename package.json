{
  "name": "foxwarm",
  "version": "1.0.0",
  "description": "A lightweight, extensible AI assistant framework with multi-channel support",
  "main": "lib/index.js",
  "bin": {
    "foxwarm": "scripts/foxwarm.js",
    "foxwarm-multica": "scripts/multicaBridge.js"
  },
  "scripts": {
    "build": "npm --prefix packages/shared run build && npm --prefix packages/cli-node run build && node -e \"for (const file of ['lib/nodeClient.js','lib/nodeClient.js.map','lib/nodes/client.js','lib/nodes/client.js.map','lib/nodes/interactive-client.js','lib/nodes/interactive-client.js.map']) require('fs').rmSync(file, { force: true })\" && tsc",
    "build:code": "npm --prefix packages/vscode-web run build:code --",
    "download:code": "npm --prefix packages/vscode-web run download:code --",
    "quality:code-index": "python3 docs/code-index/scripts/audit_index.py --source-root . --fail-on-cjk",
    "quality:unused": "node scripts/quality/unused-check.mjs",
    "test:model-cli": "node --test scripts/model.test.js",
    "test:multica-bridge": "node --test scripts/multicaBridge.test.js",
    "test:multica-setup": "node --test scripts/multicaBridgeSetup.test.js",
    "test:windows-service": "node --test scripts/windowsService.test.js",
    "test:code-index-generator": "python3 skills/code-index/tests/test_generate_code_index.py",
    "build-all": "npm ci && npm run build && npm --prefix packages/webui ci && npm --prefix packages/webui run build",
    "start": "./scripts/start.sh",
    "start:notmux": "npm run build && node lib/index.js",
    "start:windows": "node scripts/windowsService.js check-stopped && npm run build-all && node scripts/windowsService.js start",
    "restart": "./scripts/restart.sh",
    "restart:windows": "npm run build && npm --prefix packages/webui run build && node scripts/windowsService.js restart",
    "stop": "./scripts/stop.sh",
    "stop:windows": "node scripts/windowsService.js stop",
    "status:windows": "node scripts/windowsService.js status",
    "tui": "npm run build && node lib/index.js --tui",
    "node": "npm run build && node packages/cli-node/dist/client.js",
    "dev": "tsc --watch",
    "selftest:apply-patch": "npm run build && node lib/selftest/applyPatchSelfTest.js",
    "selftest:goal-reminder": "npm run build && node lib/selftest/goalReminderSelfTest.js",
    "selftest:tool-loop-stall": "npm run build && node lib/selftest/toolLoopStallSelfTest.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "cli-node": "npm run build && node packages/cli-node/dist/tui.js"
  },
  "keywords": [
    "ai",
    "assistant",
    "bot",
    "telegram",
    "matrix",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@pydantic/monty": "^0.0.19",
    "@bjorn3/browser_wasi_shim": "^0.4.1",
    "@types/blessed": "^0.1.27",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "axios": "^1.13.5",
    "blessed": "^0.1.81",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "google-auth-library": "^10.5.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "js-yaml": "^4.1.0",
    "lancedb": "^0.0.1",
    "matrix-js-sdk": "^41.0.0-rc.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "node-schedule": "^2.1.1",
    "ollama": "^0.6.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proxy-from-env": "^1.1.0",
    "puppeteer-core": "^24.37.5",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3",
    "ws": "^8.19.0",
    "xml2js": "^0.6.2",
    "ink": "^3.2.0",
    "react": "^17.0.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "@types/react": "^17.0.89",
    "esbuild": "^0.27.7"
  }
}
