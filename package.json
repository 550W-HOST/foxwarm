{
  "name": "foxwarm",
  "version": "1.0.0",
  "description": "A lightweight, extensible AI assistant framework with multi-channel support",
  "main": "lib/index.js",
  "scripts": {
    "build": "npm --prefix packages/shared run build && rm -f lib/nodeClient.js lib/nodeClient.js.map && tsc",
    "build-all": "npm install && npm run build && npm --prefix packages/webui install && npm --prefix packages/webui run build",
    "start": "./scripts/start.sh",
    "start:notmux": "npm run build && node lib/index.js",
    "restart": "./scripts/restart.sh",
    "stop": "./scripts/stop.sh",
    "tui": "npm run build && node lib/index.js --tui",
    "node": "npm run build && node lib/nodes/client.js",
    "dev": "tsc --watch",
    "selftest:apply-patch": "npm run build && node lib/selftest/applyPatchSelfTest.js",
    "selftest:todo-reminder": "npm run build && node lib/selftest/todoReminderSelfTest.js",
    "selftest:tool-loop-stall": "npm run build && node lib/selftest/toolLoopStallSelfTest.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ai",
    "assistant",
    "bot",
    "telegram",
    "matrix",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/blessed": "^0.1.27",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "axios": "^1.13.5",
    "blessed": "^0.1.81",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "google-auth-library": "^10.5.0",
    "js-yaml": "^4.1.0",
    "lancedb": "^0.0.1",
    "matrix-js-sdk": "^41.0.0-rc.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "node-schedule": "^2.1.1",
    "ollama": "^0.6.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^24.37.5",
    "telegraf": "^4.16.3",
    "ws": "^8.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3"
  }
}
