{
  "name": "foxwarm",
  "version": "0.9.7",
  "description": "A lightweight, extensible AI assistant framework with multi-channel support",
  "main": "scripts/main.js",
  "bin": {
    "foxwarm": "scripts/foxwarm.js",
    "foxwarm-multica": "scripts/multicaBridge.js"
  },
  "scripts": {
    "build": "node scripts/build-source.js",
    "build:code": "npm --prefix packages/vscode-web run build:code --",
    "download:code": "npm --prefix packages/vscode-web run download:code --",
    "quality:code-index": "python3 docs/code-index/scripts/audit_index.py --source-root . --fail-on-cjk",
    "quality:unused": "node scripts/quality/unused-check.mjs",
    "test:model-cli": "node --test scripts/model.test.js",
    "test:multica-bridge": "node --test scripts/multicaBridge.test.js",
    "test:multica-setup": "node --test scripts/multicaBridgeSetup.test.js",
    "test:windows-service": "node --test scripts/windowsService.test.js",
    "test:code-index-generator": "python3 skills/code-index/tests/test_generate_code_index.py",
    "test:code-index-audit": "python3 docs/code-index/scripts/tests/test_audit_index.py",
    "test:inventory": "node scripts/test/run-tests.mjs inventory",
    "test:unit": "node scripts/test/run-tests.mjs unit",
    "test:unit:components": "node scripts/test/run-tests.mjs unit-components",
    "test:webui:e2e": "node scripts/test/run-tests.mjs browser",
    "test:app:e2e": "node scripts/test/run-tests.mjs app",
    "test:native": "node scripts/test/run-tests.mjs native",
    "test:local": "node scripts/test/run-tests.mjs all",
    "build-all": "node scripts/build-source.js --install",
    "start": "./scripts/start.sh",
    "start:notmux": "npm run build && node .",
    "start:windows": "node scripts/windowsService.js check-stopped && npm run build-all && node scripts/windowsService.js start",
    "restart": "./scripts/restart.sh",
    "restart:windows": "npm run build -- --stage-only && node scripts/windowsService.js stop && node scripts/build-source.js --promote && node scripts/windowsService.js start",
    "stop": "./scripts/stop.sh",
    "stop:windows": "node scripts/windowsService.js stop",
    "status:windows": "node scripts/windowsService.js status",
    "node": "npm run build:node && node packages/cli-node/dist/client.js",
    "test": "npm run test:unit",
    "cli-node": "npm run build:node && node packages/cli-node/dist/tui.js",
    "build:core": "node scripts/build-source.js --core-only",
    "build:artifacts": "tsc -p packages/artifact-runtime/tsconfig.json",
    "build:assets": "npm run build:node && npm run build:host && npm run build:artifacts && npm --prefix packages/webui run build && npm --prefix packages/vscode-web/foxwarm-fs run build && npm --prefix packages/vscode-web/foxwarm-scm run build && npm --prefix packages/vscode-web/foxwarm-webui run build && npm --prefix packages/vscode-web/foxwarm-terminal run build",
    "build:delivery": "node scripts/build-source.js",
    "publish:core": "npm run build:assets && dotnet publish dotnet/Foxwarm/Foxwarm.csproj -c Release --self-contained false",
    "build:node": "npm --prefix packages/shared run build && npm --prefix packages/cli-node run build",
    "build:host": "node packages/browser-host/scripts/build-bundle.js",
    "test:managed": "node scripts/test/run-tests.mjs managed",
    "test:published": "node scripts/test/run-tests.mjs published"
  },
  "keywords": [
    "ai",
    "assistant",
    "bot",
    "telegram",
    "matrix",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@pydantic/monty": "^0.0.19",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.5",
    "esbuild": "0.27.7",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "ink": "^3.2.0",
    "js-yaml": "^4.1.0",
    "matrix-js-sdk": "^41.0.0-rc.0",
    "multer": "^2.4.0",
    "node-pty": "^1.1.0",
    "proxy-from-env": "^1.1.0",
    "puppeteer-core": "^24.37.5",
    "react": "^17.0.2",
    "sharp": "^0.34.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.11",
    "@types/react": "^17.0.89",
    "cron-parser": "4.9.0",
    "luxon": "3.7.2",
    "typescript": "^5.9.3"
  }
}
