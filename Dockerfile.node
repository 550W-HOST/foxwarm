# Node client for Foxwarm distributed execution
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dnsutils \
        file \
        git \
        iproute2 \
        iputils-ping \
        jq \
        less \
        lsof \
        netcat-openbsd \
        procps \
        python-is-python3 \
        python3 \
        python3-pip \
        rsync \
        ripgrep \
        tmux \
        unzip \
        vim-tiny \
        xz-utils \
        zip \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source and dependencies
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src
COPY templates ./templates

# Install and build
RUN npm ci && npm run build

# Set environment
ENV NODE_ENV=production

CMD ["node", "lib/nodeClient.js", "--host", "http://host.docker.internal:3001", "--id", "sandbox-node", "--token", "PLACEHOLDER_TOKEN"]
