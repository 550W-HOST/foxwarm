# Node client for Foxwarm distributed execution
FROM node:22-bookworm-slim

WORKDIR /app

# Copy source and dependencies
COPY package.json pnpm-lock.yaml tsconfig.json ./
COPY src ./src
COPY templates ./templates

# Install and build
RUN npm install -g pnpm && pnpm install --frozen-lockfile && pnpm build

# Set environment
ENV NODE_ENV=production

CMD ["node", "lib/nodeClient.js", "--host", "http://host.docker.internal:3001", "--id", "sandbox-node", "--token", "PLACEHOLDER_TOKEN"]